{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      ".dockerignore",
      "railway.json",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "next.config.ts",
      "app/**",
      "components/**",
      "features/**",
      "hooks/**",
      "lib/**",
      "data/**",
      "public/**",
      "proxy.ts",
      "instrumentation*"
    ]
  },
  "deploy": {
    "healthcheckPath": "/archive",
    "healthcheckTimeout": 90,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
